{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/main/main.py": {
      "maxDuration": 300,
      "includeFiles": "backend/main/{index.html,background.jpg,models/**,utils/**,wrinkle_engine/**,res/cp/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/backend/main/main" }
  ]
}
