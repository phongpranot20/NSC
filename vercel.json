{
  "version": 2,
  "builds": [
    {
      "src": "backend/main/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 300,
        "includeFiles": "backend/main/{index.html,background.jpg,models/**,utils/**,wrinkle_engine/**,native_libs/**}"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "backend/main/main.py" }
  ]
}
